# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# MongoDB Connection String (Leave empty for automatic in-memory fallback during local testing)
MONGODB_URI=

# Razorpay Payment Gateway Credentials
# Find these in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Google Calendar & Google Meet OAuth2 Credentials
# From Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
GOOGLE_CALENDAR_ID=primary

# Resend Transactional Email API
# From https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_KEY
EMAIL_FROM=Harsha <bookings@yourverifieddomain.com>

# Admin Authentication & Initial Setup
JWT_SECRET=super-secret-jwt-key-replace-in-production
ADMIN_SETUP_SECRET=harsha-initial-setup-secret-token-2026
ADMIN_DEFAULT_USERNAME=harsha
ADMIN_DEFAULT_PASSWORD=Harsha@2026
ADMIN_DEFAULT_EMAIL=harsha@example.com
