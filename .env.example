# ==========================================
# Harsha Consultation Booking Platform .env
# ==========================================

# Backend Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/callbook?retryWrites=true&w=majority

# Razorpay Credentials (from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Calendar OAuth2 API (Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=1//04xxxxxxxxxxxx
GOOGLE_CALENDAR_ID=primary

# Email Configuration Option A: Direct Gmail SMTP (Free, no domain needed, sends to any email)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email Configuration Option B: Resend Email API (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Harsha <bookings@yourdomain.com>

# Admin Authentication
JWT_SECRET=generate-a-strong-32-byte-hex-string
ADMIN_SETUP_SECRET=strong-one-time-setup-token
ADMIN_DEFAULT_USERNAME=harsha
ADMIN_DEFAULT_PASSWORD=Harsha@2026
ADMIN_DEFAULT_EMAIL=harshavardhanreddy.0712@gmail.com

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:5001/api
VITE_RAZORPAY_KEY_ID=rzp_test_mock_harsha
